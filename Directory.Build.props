<Project>

  <!-- Propiedades comunes a toda la solucion Cotizador3D v2. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <Product>Cotizador3D</Product>
    <Company>Cotizador3D</Company>
    <Authors>Cotizador3D</Authors>
    <NeutralLanguage>es-AR</NeutralLanguage>
  </PropertyGroup>

</Project>
