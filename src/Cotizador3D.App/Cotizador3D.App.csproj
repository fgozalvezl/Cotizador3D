<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Cotizador3D.App</RootNamespace>
    <AssemblyName>Cotizador3D</AssemblyName>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Description>Interfaz de escritorio (WPF) de Cotizador3D.</Description>
  </PropertyGroup>

  <!-- Publicacion: un solo .exe autocontenido, comprimido y sin simbolos. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cotizador3D.Core\Cotizador3D.Core.csproj" />
  </ItemGroup>

</Project>
