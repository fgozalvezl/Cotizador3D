                                                         To="1.03" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorSecundario}" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorBorde}" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorSecundarioPresionado}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorSecundarioHover}" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.03" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.03" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.4" />
                            <Setter Property="Foreground" Value="{StaticResource PincelTextoTenue}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

