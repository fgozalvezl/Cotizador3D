<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:Cotizador3D.App.Behaviors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cotizador3D;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Cotizador3D;component/Themes/Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================================================================
         Reglas de la hoja de estilos
         - Lo que se anima (color de fondo, borde, escala) se declara EN LINEA
           dentro de la plantilla: las animaciones ganan sobre el valor local.
         - Lo que se cambia con Setter (Opacity, Foreground) nunca se fija en
           linea, porque un Setter de trigger no puede pisar un valor local.
         ================================================================== -->

    <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />

    <!-- Foco de teclado: se dibuja como adorno, sin tocar la plantilla. -->
    <Style x:Key="EstiloFocoVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="10" RadiusY="10"
                               Stroke="{StaticResource PincelAcento}"
                               StrokeThickness="1.5"
                               StrokeDashArray="2 2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Texto ============================ -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="TituloVentana" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="2,0,2,5" />
    </Style>

    <Style x:Key="EtiquetaResultado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValorResultado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="EtiquetaTotal" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaResultado}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
    </Style>

    <Style x:Key="ValorTotal" TargetType="TextBlock" BasedOn="{StaticResource ValorResultado}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="EtiquetaFinal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSobreAcento}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ValorFinal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSobreAcento}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- ========================= Contenedores ========================= -->

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PincelSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBordeSuave}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Separador" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource PincelBorde}" />
        <Setter Property="Margin" Value="0,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- =========================== Botones =========================== -->

    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSobreAcento}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColorAcento}" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorAcentoHover}" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.03" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.03" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorAcento}" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorAcentoPresionado}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Fondo"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorAcentoHover}" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.03" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Fondo"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.03" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.4" />
                            <Setter Property="Foreground" Value="{StaticResource PincelTextoTenue}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

