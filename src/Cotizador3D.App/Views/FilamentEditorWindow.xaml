<Window x:Class="Cotizador3D.App.Views.FilamentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Cotizador3D.App.Behaviors"
        Title="{Binding Titulo}"
        Style="{StaticResource VentanaBase}"
        Width="440" Height="360"
        MinWidth="400" MinHeight="340"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Raiz" Opacity="0" Margin="22">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource AnimAparecerVentana}" />
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Detalles del Filamento" Style="{StaticResource TituloSeccion}" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Marca:" Style="{StaticResource EtiquetaCampo}" />
            <TextBox b:Marcador.Texto="Marca del Filamento"
                     Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Tipo:" Style="{StaticResource EtiquetaCampo}" Margin="2,14,2,5" />
            <ComboBox ItemsSource="{Binding Tipos}"
                      SelectedItem="{Binding TipoSeleccionado, Mode=TwoWay}" />

            <TextBlock Text="Precio por kg:" Style="{StaticResource EtiquetaCampo}" Margin="2,14,2,5" />
            <TextBox b:Marcador.Texto="Precio por KG (ej: 18500.00)"
                     Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Style="{StaticResource BotonSecundario}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Command="{Binding CancelarCommand}" />
            <Button Content="Guardar"
                    Style="{StaticResource BotonPrimario}"
                    MinWidth="120"
                    IsDefault="True"
                    Command="{Binding GuardarCommand}" />
        </StackPanel>
    </Grid>
</Window>
